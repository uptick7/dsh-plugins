{
  "name": "@local/commands-bridge",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Bridges markdown slash-commands from shared, harness, and project directories into the command registry, with a Settings page for discovery and toggles.",
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node --test *.test.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "commands-md.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.ru.md",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
