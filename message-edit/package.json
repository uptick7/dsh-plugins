{
  "name": "@uptick7/dsh-message-edit",
  "version": "1.5.1",
  "license": "MIT",
  "type": "module",
  "description": "Edit a sent user message in place: the edited text replaces the previous exchange in the same session's model context, and the session continues without a fork.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "plugin",
    "session",
    "message-edit"
  ],
  "author": {
    "name": "uptick7",
    "url": "https://github.com/uptick7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uptick7/dsh-plugins.git",
    "directory": "message-edit"
  },
  "homepage": "https://github.com/uptick7/dsh-plugins/tree/main/message-edit#readme",
  "bugs": "https://github.com/uptick7/dsh-plugins/issues",
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "scripts": {
    "test": "node --test *.test.js",
    "check": "node --check index.js && node --check client.js",
    "prepublishOnly": "npm run check"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.ru.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
